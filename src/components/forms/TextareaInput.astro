---
interface Props {
  id: string;
  name?: string;
  label: string;

  value?: string;
  placeholder?: string;

  rows?: number;

  minlength?: number;
  maxlength?: number;

  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;

  dir?: "rtl" | "ltr" | "auto";

  hint?: string;
  error?: string;

  class?: string;
}

const {
  id,
  name = id,
  label,

  value = "",
  placeholder,

  rows = 6,

  minlength,
  maxlength,

  required = false,
  disabled = false,
  readonly = false,

  dir,

  hint,
  error,

  class: className = "",
} = Astro.props;

const descriptionId = error
  ? `${id}-error`
  : hint
    ? `${id}-hint`
    : undefined;

const textareaClasses = [
  "w-full resize-y rounded-control border bg-surface-raised px-3.5 py-3 text-ink outline-none transition duration-200 ease-standard",
  "placeholder:text-slate-400",
  "disabled:cursor-not-allowed disabled:bg-surface-soft disabled:text-muted disabled:opacity-70",
  error
    ? "border-danger focus:border-danger focus:ring-4 focus:ring-red-100"
    : "border-line-strong focus:border-brand-600 focus:ring-4 focus:ring-brand-100",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class="space-y-2">
  <label
    for={id}
    class="block text-sm font-semibold text-ink"
  >
    {label}

    {
      required && (
        <span
          class="mr-1 text-danger"
          aria-hidden="true"
        >
          *
        </span>
      )
    }
  </label>

  <textarea
    id={id}
    name={name}
    rows={rows}
    placeholder={placeholder}
    minlength={minlength}
    maxlength={maxlength}
    required={required}
    disabled={disabled}
    readonly={readonly}
    dir={dir}
    class={textareaClasses}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={descriptionId}
  >{value}</textarea>

  {
    error ? (
      <p
        id={`${id}-error`}
        class="text-sm font-medium text-danger"
      >
        {error}
      </p>
    ) : hint ? (
      <p
        id={`${id}-hint`}
        class="text-sm text-muted"
      >
        {hint}
      </p>
    ) : null
  }
</div>