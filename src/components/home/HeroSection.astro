---
import Badge from "../common/Badge.astro";
import Button from "../common/Button.astro";
import Card from "../common/Card.astro";
import { siteConfig } from "../../config/site";

const primaryPhone = siteConfig.contact.primaryPhone.trim();

const phoneHref = primaryPhone
  ? `tel:${primaryPhone.replace(/[^\d+]/g, "")}`
  : undefined;

const hasPhone = Boolean(phoneHref);
---

<section class="relative overflow-hidden border-b border-line bg-surface">
  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-l from-transparent via-brand-300 to-transparent"
  ></div>

  <div class="site-container section-space">
    <div class="grid items-center gap-10 lg:grid-cols-[1.08fr_0.92fr] lg:gap-14">

      <div class="max-w-3xl">
        <Badge variant="brand">
          خدمات تخصصی CNC در {siteConfig.location.serviceArea}
        </Badge>

        <h1 class="mt-6 text-4xl font-black leading-[1.35] tracking-tight text-ink sm:text-5xl lg:text-6xl">
          تعمیر تخصصی CNC و
          <span class="text-brand-700">
            تأمین قطعات صنعتی
          </span>
        </h1>

        <p class="mt-6 max-w-2xl text-base leading-8 text-muted sm:text-lg sm:leading-9">
          عیب‌یابی دستگاه، تعمیر سروو و درایو، بررسی اسپیندل و کنترلر،
          تأمین قطعات بر اساس Part Number و پشتیبانی فنی برای ماشین‌آلات CNC.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <Button
            href={phoneHref}
            size="lg"
            disabled={!hasPhone}
            ariaLabel={
              hasPhone
                ? "تماس فوری با CNC Center"
                : "شماره تماس هنوز ثبت نشده است"
            }
          >
            تماس فوری
          </Button>

          <Button
            href="/request/repair/"
            variant="secondary"
            size="lg"
          >
            درخواست تعمیر
          </Button>

          <Button
            href="/request/part/"
            variant="ghost"
            size="lg"
          >
            درخواست قطعه
          </Button>
        </div>

        {
          !hasPhone && (
            <p class="mt-3 text-xs leading-6 text-muted">
              شماره تماس اصلی هنوز در تنظیمات سایت ثبت نشده و دکمه تماس
              تا زمان ثبت شماره غیرفعال است.
            </p>
          )
        }

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-ink-soft">
          <span class="inline-flex items-center gap-2">
            <span
              aria-hidden="true"
              class="size-2 rounded-full bg-signal"
            ></span>
            تعمیر دستگاه و تجهیزات CNC
          </span>

          <span class="inline-flex items-center gap-2">
            <span
              aria-hidden="true"
              class="size-2 rounded-full bg-signal"
            ></span>
            تأمین قطعه با Part Number
          </span>

          <span class="inline-flex items-center gap-2">
            <span
              aria-hidden="true"
              class="size-2 rounded-full bg-signal"
            ></span>
            خدمات از تهران به سراسر ایران
          </span>
        </div>
      </div>

      <div class="relative">
        <div
          aria-hidden="true"
          class="absolute -inset-5 -z-10 rounded-panel border border-brand-100 bg-brand-50"
        ></div>

        <Card
          as="section"
          padding="lg"
          class="relative overflow-hidden"
        >
          <div class="flex items-start justify-between gap-5">
            <div>
              <p class="text-sm font-bold text-brand-700">
                مرکز پاسخ‌گویی فنی CNC
              </p>

              <h2 class="mt-2 text-2xl font-black tracking-tight text-ink sm:text-3xl">
                دستگاه متوقف شده یا قطعه پیدا نمی‌شود؟
              </h2>
            </div>

            <span
              aria-hidden="true"
              class="grid size-12 shrink-0 place-items-center rounded-control border border-brand-200 bg-brand-50 font-black text-brand-700"
            >
              CNC
            </span>
          </div>

          <div class="mt-7 grid gap-3">
            <div class="rounded-control border border-line bg-surface-soft p-4">
              <p class="text-xs font-bold text-muted">
                01 — تعمیر
              </p>

              <p class="mt-1 font-bold text-ink">
                عیب‌یابی دستگاه و تجهیزات الکترونیکی CNC
              </p>
            </div>

            <div class="rounded-control border border-line bg-surface-soft p-4">
              <p class="text-xs font-bold text-muted">
                02 — قطعه
              </p>

              <p class="mt-1 font-bold text-ink">
                جستجو و تأمین قطعه بر اساس برند و Part Number
              </p>
            </div>

            <div class="rounded-control border border-line bg-surface-soft p-4">
              <p class="text-xs font-bold text-muted">
                03 — آلارم
              </p>

              <p class="mt-1 font-bold text-ink">
                بررسی خطا و مسیر اولیه عیب‌یابی کنترل و درایو
              </p>
            </div>
          </div>

          <div class="mt-6 border-t border-line pt-5">
            <p class="text-sm leading-7 text-muted">
              برای شروع بررسی، مدل دستگاه، برند کنترل، کد آلارم یا
              Part Number قطعه را آماده کنید.
            </p>

            <p
              dir="ltr"
              class="mt-3 font-mono text-sm font-bold text-ink-soft"
            >
              FANUC · SIEMENS · MITSUBISHI · HEIDENHAIN
            </p>
          </div>
        </Card>
      </div>

    </div>
  </div>
</section>