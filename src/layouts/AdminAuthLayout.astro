---
import "../styles/global.css";

import {
  siteConfig,
} from "../config/site";

interface Props {
  title: string;
}

const {
  title,
} = Astro.props;

const pageTitle =
  `${title} | ${siteConfig.brand.name}`;
---

<!doctype html>
<html
  lang="fa"
  dir="rtl"
>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="robots"
      content="noindex,nofollow"
    />

    <meta
      name="referrer"
      content="no-referrer"
    />

    <title>{pageTitle}</title>

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
  </head>

  <body class="min-h-screen bg-surface text-ink antialiased">
    <main
      class="grid min-h-screen place-items-center px-4 py-8 sm:px-6"
    >
      <div class="w-full max-w-md">
        <div class="mb-6 text-center">
          <a
            href="/"
            class="inline-flex items-center gap-3 rounded-control focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-brand-100"
          >
            <span
              dir="ltr"
              class="grid size-11 place-items-center rounded-control bg-brand-800 text-xs font-black tracking-wide text-white"
              aria-hidden="true"
            >
              CNC
            </span>

            <span class="text-right">
              <span class="block text-base font-black text-ink">
                {siteConfig.brand.name}
              </span>

              <span class="mt-0.5 block text-xs text-muted">
                پنل مدیریت
              </span>
            </span>
          </a>
        </div>

        <slot />

        <p class="mt-6 text-center text-xs leading-6 text-muted">
          ورود به این بخش فقط برای مدیران مجاز است.
        </p>
      </div>
    </main>
  </body>
</html>
