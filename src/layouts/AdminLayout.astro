---
import "@fontsource-variable/vazirmatn/wght.css";
import "../styles/global.css";

import AdminHeader from "../components/admin/AdminHeader.astro";
import AdminSidebar from "../components/admin/AdminSidebar.astro";

import { siteConfig } from "../config/site";

interface Props {
  title: string;
  brandName?: string;
  brandLogoUrl?: string;
}

const {
  title,
  brandName =
    siteConfig.brand.name,
  brandLogoUrl,
} = Astro.props;

const session =
  Astro.locals.adminSession;

const adminEmail =
  session?.admin.email ??
  "admin";

const pathname =
  Astro.url.pathname;

const pageTitle =
  `${title} | ${brandName}`;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <title>{pageTitle}</title>

    <meta
      name="robots"
      content="noindex,nofollow"
    />

    <meta
      name="referrer"
      content="no-referrer"
    />

    <meta
      name="theme-color"
      content="#f6f8fb"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
  </head>

  <body class="min-h-screen bg-surface text-ink antialiased">
    <div class="min-h-screen xl:flex">
      <AdminSidebar
        brandName={brandName}
        brandLogoUrl={brandLogoUrl}
        pathname={pathname}
      />

      <div class="min-w-0 flex-1">
        <AdminHeader
          pageTitle={title}
          adminEmail={adminEmail}
        />

        <main class="px-4 py-6 md:px-6 md:py-8">
          <div class="mx-auto w-full max-w-[96rem]">
            <slot />
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
