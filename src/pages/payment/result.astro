---
const params =
  new URL(Astro.request.url)
    .searchParams;

const orderId =
  params.get("orderId");

const refId =
  params.get("refId");

const verified =
  params.get("verified") === "true";
---

<html lang="fa" dir="rtl">
  <head>
    <title>نتیجه پرداخت</title>
  </head>

  <body>
    <main>

      {
        verified ? (
          <>
            <h1>
              پرداخت موفق بود
            </h1>

            <p>
              سفارش شما ثبت شد.
            </p>

            {
              orderId && (
                <p>
                  شماره سفارش:
                  {orderId}
                </p>
              )
            }

            {
              refId && (
                <p>
                  کد پیگیری:
                  {refId}
                </p>
              )
            }
          </>
        ) : (
          <>
            <h1>
              پرداخت ناموفق بود
            </h1>

            <p>
              پرداخت تایید نشد.
            </p>
          </>
        )
      }

    </main>
  </body>
</html>
