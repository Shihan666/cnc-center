---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

import { siteConfig } from "../../config/site";

import {
  articleCategoryLabels,
  formatArticleDate,
  getActiveArticles,
  getArticleCategoryLabel,
  getArticleHref,
} from "../../lib/articles";

const allArticles =
  await getCollection("articles");

const articles =
  getActiveArticles(allArticles);

const siteUrl =
  siteConfig.seo.siteUrl.replace(
    /\/$/,
    "",
  );

const canonical =
  `${siteUrl}/blog/`;

const pageTitle =
  "دانشنامه CNC | راهنماهای فنی، عیب‌یابی و نگهداری";

const pageDescription =
  "دانشنامه CNC Center برای راهنماهای فنی CNC، عیب‌یابی، نگهداری، تعمیرات، قطعات، کنترل و اتوماسیون و راهنمای انتخاب تجهیزات.";

const itemListStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "دانشنامه CNC",
  url: canonical,
  inLanguage: "fa-IR",
  numberOfItems: articles.length,
  itemListElement: articles.map(
    (article, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url:
        `${siteUrl}${getArticleHref(article)}`,
      name: article.data.title,
    }),
  ),
};

const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "صفحه اصلی",
      item: `${siteUrl}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "دانشنامه CNC",
      item: canonical,
    },
  ],
};

const topicLabels =
  Object.values(articleCategoryLabels);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      itemListStructuredData,
    )}
  ></script>

  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(
      breadcrumbStructuredData,
    )}
  ></script>

  <main>
    <section
      class="border-b border-line bg-surface-raised"
    >
      <div
        class="site-container py-12 md:py-16 lg:py-20"
      >
        <div class="max-w-4xl">
          <p
            class="text-sm font-black text-brand-700"
          >
            دانشنامه CNC Center
          </p>

          <h1
            class="mt-3 text-3xl font-black leading-tight text-ink md:text-4xl lg:text-5xl"
          >
            دانش فنی برای عیب‌یابی،
            نگهداری و انتخاب تجهیزات CNC
          </h1>

          <p
            class="mt-5 max-w-3xl text-base leading-8 text-muted md:text-lg"
          >
            مجموعه‌ای ساختاریافته از
            راهنماهای فنی درباره دستگاه CNC،
            سروو و محور، کنترلر، اسپیندل،
            قطعات، تعمیرات و نگهداری.
          </p>

          <div
            class="mt-7 flex flex-wrap gap-3"
          >
            <a
              href="/alarms/"
              class="inline-flex min-h-11 items-center justify-center rounded-xl border border-line bg-surface px-5 text-sm font-black text-ink transition hover:border-brand-300 hover:text-brand-700"
            >
              مرکز آلارم CNC
            </a>

            <a
              href="/repairs/"
              class="inline-flex min-h-11 items-center justify-center rounded-xl border border-line bg-surface px-5 text-sm font-black text-ink transition hover:border-brand-300 hover:text-brand-700"
            >
              سوابق تعمیر
            </a>

            <a
              href="/services/"
              class="inline-flex min-h-11 items-center justify-center rounded-xl bg-brand-600 px-5 text-sm font-black text-white transition hover:bg-brand-700"
            >
              خدمات تعمیر CNC
            </a>
          </div>
        </div>
      </div>
    </section>

    {
      articles.length > 0 ? (
        <section class="site-container py-12 md:py-16">
          <div
            class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between"
          >
            <div>
              <p
                class="text-sm font-black text-brand-700"
              >
                مطالب منتشرشده
              </p>

              <h2
                class="mt-2 text-2xl font-black text-ink md:text-3xl"
              >
                تازه‌ترین مطالب دانشنامه
              </h2>
            </div>

            <p
              class="text-sm font-bold text-muted"
            >
              {articles.length.toLocaleString("fa-IR")}
              {" "}
              مطلب
            </p>
          </div>

          <div
            class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3"
          >
            {
              articles.map((article) => {
                const publishedAt =
                  formatArticleDate(
                    article.data.publishedAt,
                  );

                const categoryLabel =
                  getArticleCategoryLabel(
                    article,
                  );

                return (
                  <article
                    class="flex h-full flex-col rounded-2xl border border-line bg-surface-raised p-6 shadow-sm"
                  >
                    <div
                      class="flex flex-wrap items-center gap-2"
                    >
                      <span
                        class="rounded-full bg-brand-50 px-3 py-1 text-xs font-black text-brand-700"
                      >
                        {categoryLabel}
                      </span>

                      {
                        article.data.featured && (
                          <span
                            class="rounded-full border border-line px-3 py-1 text-xs font-black text-muted"
                          >
                            منتخب
                          </span>
                        )
                      }
                    </div>

                    <h2
                      class="mt-4 text-xl font-black leading-8 text-ink"
                    >
                      <a
                        href={getArticleHref(
                          article,
                        )}
                        class="transition hover:text-brand-700"
                      >
                        {article.data.title}
                      </a>
                    </h2>

                    <p
                      class="mt-3 flex-1 text-sm leading-7 text-muted"
                    >
                      {article.data.excerpt}
                    </p>

                    <div
                      class="mt-5 flex items-center justify-between gap-4 border-t border-line pt-4"
                    >
                      <span
                        class="text-xs font-bold text-muted"
                      >
                        {publishedAt ?? "بدون تاریخ"}
                      </span>

                      <a
                        href={getArticleHref(
                          article,
                        )}
                        class="text-sm font-black text-brand-700"
                      >
                        مطالعه مطلب
                      </a>
                    </div>
                  </article>
                );
              })
            }
          </div>
        </section>
      ) : (
        <section
          class="site-container py-12 md:py-16"
        >
          <div
            class="rounded-2xl border border-line bg-surface-raised p-6 md:p-8"
          >
            <p
              class="text-sm font-black text-brand-700"
            >
              دانشنامه در حال تکمیل است
            </p>

            <h2
              class="mt-2 text-2xl font-black text-ink"
            >
              مطالب فنی پس از بررسی و تأیید
              منتشر می‌شوند
            </h2>

            <p
              class="mt-4 max-w-3xl text-sm leading-7 text-muted md:text-base md:leading-8"
            >
              ساختار دانشنامه آماده است، اما
              در حال حاضر مطلب عمومی منتشرشده‌ای
              وجود ندارد. تا زمان انتشار،
              مرکز آلارم، سوابق تعمیر و صفحات
              خدمات CNC منابع عملی موجود در
              سایت هستند.
            </p>
          </div>
        </section>
      )
    }

    <section
      class="border-y border-line bg-surface-raised"
    >
      <div
        class="site-container py-12 md:py-16"
      >
        <div class="max-w-3xl">
          <p
            class="text-sm font-black text-brand-700"
          >
            موضوعات دانشنامه
          </p>

          <h2
            class="mt-2 text-2xl font-black text-ink md:text-3xl"
          >
            پوشش محتوایی برنامه‌ریزی‌شده
          </h2>

          <div
            class="mt-6 flex flex-wrap gap-2"
          >
            {
              topicLabels.map((label) => (
                <span
                  class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-bold text-ink"
                >
                  {label}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="site-container py-12 md:py-16">
      <div
        class="grid gap-5 md:grid-cols-2"
      >
        <a
          href="/request/repair/"
          class="rounded-2xl border border-line bg-surface-raised p-6 transition hover:border-brand-300"
        >
          <p
            class="text-sm font-black text-brand-700"
          >
            مشکل دستگاه دارید؟
          </p>

          <h2
            class="mt-2 text-xl font-black text-ink"
          >
            اطلاعات اولیه تعمیر را ثبت کنید
          </h2>

          <p
            class="mt-3 text-sm leading-7 text-muted"
          >
            مشخصات دستگاه، کنترلر، آلارم و
            شرح خرابی را در قالب یک درخواست
            ساختاریافته آماده کنید.
          </p>
        </a>

        <a
          href="/request/part/"
          class="rounded-2xl border border-line bg-surface-raised p-6 transition hover:border-brand-300"
        >
          <p
            class="text-sm font-black text-brand-700"
          >
            قطعه CNC نیاز دارید؟
          </p>

          <h2
            class="mt-2 text-xl font-black text-ink"
          >
            درخواست تأمین قطعه آماده کنید
          </h2>

          <p
            class="mt-3 text-sm leading-7 text-muted"
          >
            Part Number، برند، مدل دستگاه و
            سایر اطلاعات تطبیق قطعه را ثبت
            کنید.
          </p>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
