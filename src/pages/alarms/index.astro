---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/common/Badge.astro";
import Button from "../../components/common/Button.astro";
import Card from "../../components/common/Card.astro";

import { siteConfig } from "../../config/site";

import {
  alarmCategoryLabels,
  formatAlarmDate,
  getActiveAlarms,
  getAlarmCategoryLabel,
  getAlarmHref,
  getAlarmServiceTitles,
} from "../../lib/alarms";

const allAlarms = await getCollection("alarms");
const alarms = getActiveAlarms(allAlarms);

const siteUrl = siteConfig.seo.siteUrl.replace(/\/$/, "");
const canonical = `${siteUrl}/alarms/`;

const pageTitle = "مرکز آلارم و خطای CNC";
const pageDescription =
  "پایگاه بررسی کدهای آلارم CNC، معنی خطا، علت‌های محتمل، بررسی‌های اولیه و مسیر مناسب عیب‌یابی برای کنترلر، سروو، اسپیندل و تجهیزات صنعتی.";

const structuredData =
  alarms.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: pageTitle,
        url: canonical,
        itemListElement: alarms.map(
          (alarm, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: alarm.data.title,
            url: `${siteUrl}${getAlarmHref(alarm)}`,
          }),
        ),
      }
    : null;

const categoryCards = [
  {
    id: "controller",
    description:
      "پیام‌ها و Faultهای کنترل CNC، سیستم و اجرای سیکل.",
  },
  {
    id: "servo",
    description:
      "Servo Alarm، محور، درایو و خطاهای حرکت.",
  },
  {
    id: "spindle",
    description:
      "خطاهای Spindle Drive، موتور و فرمان اسپیندل.",
  },
  {
    id: "feedback",
    description:
      "Encoder، Feedback، موقعیت و ارتباط فیدبک.",
  },
  {
    id: "communication",
    description:
      "شبکه، Bus، ارتباط بین کنترل، درایو و ماژول‌ها.",
  },
  {
    id: "power",
    description:
      "برق ورودی، Power Supply و وضعیت تغذیه تجهیزات.",
  },
] as const;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
>
  {
    structuredData && (
      <script
        slot="head"
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      ></script>
    )
  }

  <main>
    <section class="border-b border-line bg-surface-raised py-12 md:py-16">
      <div class="site-container">
        <div class="max-w-4xl">
          <Badge variant="brand">
            Alarm Center
          </Badge>

          <h1 class="mt-5 text-4xl font-black leading-[1.45] tracking-tight text-ink md:text-6xl">
            مرکز آلارم و خطای CNC
          </h1>

          <p class="mt-5 max-w-3xl text-base leading-8 text-muted md:text-lg">
            کد آلارم می‌تواند نقطه شروع عیب‌یابی باشد، اما
            برای تشخیص صحیح باید همراه با برند، مدل کنترلر یا
            درایو، تجهیز درگیر و شرایط ایجاد خطا بررسی شود.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <Button
              href="/services/alarm-diagnosis/"
              size="lg"
            >
              خدمات تشخیص آلارم
            </Button>

            <Button
              href="/request/repair/"
              variant="secondary"
              size="lg"
            >
              ثبت درخواست بررسی
            </Button>
          </div>
        </div>
      </div>
    </section>

    <section class="section-space bg-surface">
      <div class="site-container">
        <div class="max-w-3xl">
          <p class="text-sm font-bold text-brand-700">
            دسته‌بندی خطاها
          </p>

          <h2 class="mt-2 text-2xl font-black text-ink md:text-3xl">
            نقطه شروع بررسی بر اساس نوع Alarm
          </h2>

          <p class="mt-3 text-sm leading-8 text-muted">
            نوع خطا به انتخاب مسیر اولیه کمک می‌کند، اما
            کد یکسان ممکن است در سری‌ها و تجهیزات مختلف
            مفهوم یا شرایط متفاوتی داشته باشد.
          </p>
        </div>

        <div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
          {
            categoryCards.map((category) => (
              <Card>
                <p
                  dir="ltr"
                  class="text-xs font-black uppercase tracking-wide text-brand-700"
                >
                  {category.id}
                </p>

                <h3 class="mt-3 text-lg font-black text-ink">
                  {alarmCategoryLabels[category.id]}
                </h3>

                <p class="mt-3 text-sm leading-7 text-muted">
                  {category.description}
                </p>
              </Card>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-y border-line bg-surface-raised py-10 md:py-14">
      <div class="site-container">
        <div class="grid gap-5 md:grid-cols-3">
          <Card>
            <p class="text-sm font-bold text-brand-700">
              01 — کد کامل
            </p>

            <h2 class="mt-2 text-lg font-black text-ink">
              متن و Code را دقیق ثبت کنید
            </h2>

            <p class="mt-3 text-sm leading-7 text-muted">
              عکس نمایشگر و متن کامل Alarm از ثبت ناقص یا
              اشتباه کد جلوگیری می‌کند.
            </p>
          </Card>

          <Card>
            <p class="text-sm font-bold text-brand-700">
              02 — مدل تجهیز
            </p>

            <h2 class="mt-2 text-lg font-black text-ink">
              برند، سری و مدل را مشخص کنید
            </h2>

            <p class="mt-3 text-sm leading-7 text-muted">
              مدل کنترلر، Servo Drive، Spindle Drive یا
              تجهیز درگیر برای تفسیر درست خطا مهم است.
            </p>
          </Card>

          <Card>
            <p class="text-sm font-bold text-brand-700">
              03 — شرایط وقوع
            </p>

            <h2 class="mt-2 text-lg font-black text-ink">
              اتفاق قبل از Alarm را توضیح دهید
            </h2>

            <p class="mt-3 text-sm leading-7 text-muted">
              زمان ایجاد خطا، محور یا عملیات درگیر و
              تغییرات اخیر می‌تواند مسیر عیب‌یابی را کوتاه کند.
            </p>
          </Card>
        </div>
      </div>
    </section>

    <section class="section-space bg-surface">
      <div class="site-container">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-bold text-brand-700">
              پایگاه دانش
            </p>

            <h2 class="mt-2 text-2xl font-black text-ink md:text-3xl">
              کدهای آلارم ثبت‌شده
            </h2>
          </div>

          {
            alarms.length > 0 && (
              <p class="text-sm font-bold text-muted">
                {new Intl.NumberFormat("fa-IR").format(
                  alarms.length,
                )}
                {" "}
                رکورد فعال
              </p>
            )
          }
        </div>

        {
          alarms.length > 0 ? (
            <div class="grid gap-6 lg:grid-cols-2">
              {
                alarms.map((alarm) => {
                  const publishedAt =
                    formatAlarmDate(alarm.data.publishedAt);

                  const serviceTitles =
                    getAlarmServiceTitles(alarm);

                  return (
                    <Card
                      interactive
                      padding="lg"
                    >
                      <div class="flex flex-wrap gap-2">
                        <Badge
                          variant="brand"
                          size="sm"
                          dir="ltr"
                        >
                          {alarm.data.brand}
                        </Badge>

                        <Badge
                          variant="warning"
                          size="sm"
                          dir="ltr"
                        >
                          {alarm.data.code}
                        </Badge>

                        <Badge
                          variant="neutral"
                          size="sm"
                        >
                          {getAlarmCategoryLabel(alarm)}
                        </Badge>
                      </div>

                      <h3 class="mt-5 text-xl font-black leading-8 text-ink">
                        <a
                          href={getAlarmHref(alarm)}
                          class="transition hover:text-brand-700"
                        >
                          {alarm.data.title}
                        </a>
                      </h3>

                      <p class="mt-3 text-sm leading-7 text-muted">
                        {alarm.data.excerpt}
                      </p>

                      <div class="mt-5 rounded-control border border-line bg-surface-soft px-4 py-3">
                        <p class="text-xs font-bold text-brand-700">
                          معنی / وضعیت
                        </p>

                        <p class="mt-2 text-sm font-bold leading-7 text-ink-soft">
                          {alarm.data.meaning}
                        </p>
                      </div>

                      {
                        serviceTitles.length > 0 && (
                          <div class="mt-4 flex flex-wrap gap-2">
                            {
                              serviceTitles.map((title) => (
                                <span class="rounded-full border border-line bg-surface px-3 py-1 text-xs font-bold text-muted">
                                  {title}
                                </span>
                              ))
                            }
                          </div>
                        )
                      }

                      <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
                        {
                          publishedAt ? (
                            <p class="text-xs font-bold text-muted">
                              انتشار: {publishedAt}
                            </p>
                          ) : (
                            <span></span>
                          )
                        }

                        <a
                          href={getAlarmHref(alarm)}
                          class="text-sm font-black text-brand-700 transition hover:text-brand-800"
                        >
                          مشاهده جزئیات ←
                        </a>
                      </div>
                    </Card>
                  );
                })
              }
            </div>
          ) : (
            <div class="rounded-panel border border-line bg-surface-raised p-7 shadow-card md:p-10">
              <Badge variant="info">
                در حال آماده‌سازی
              </Badge>

              <h3 class="mt-5 text-2xl font-black text-ink">
                پایگاه عمومی آلارم‌ها در حال تکمیل است
              </h3>

              <p class="mt-3 max-w-3xl text-sm leading-8 text-muted">
                هنوز رکورد فعال عمومی برای نمایش وجود ندارد.
                اگر دستگاه شما Alarm یا Fault دارد، کد کامل،
                برند، مدل تجهیز و شرح شرایط ایجاد خطا را برای
                بررسی اولیه ارسال کنید.
              </p>

              <div class="mt-6 flex flex-wrap gap-3">
                <Button href="/request/repair/">
                  ثبت درخواست بررسی
                </Button>

                <Button
                  href="/services/alarm-diagnosis/"
                  variant="secondary"
                >
                  خدمات تشخیص آلارم
                </Button>
              </div>
            </div>
          )
        }
      </div>
    </section>

    <section class="border-t border-line bg-brand-950 py-10 text-white md:py-12">
      <div class="site-container">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-3xl">
            <p class="text-sm font-bold text-brand-200">
              کد آلارم دستگاه را دارید؟
            </p>

            <h2 class="mt-2 text-2xl font-black md:text-3xl">
              کد، مدل دستگاه و تصویر نمایشگر را ارسال کنید
            </h2>

            <p class="mt-3 text-sm leading-7 text-brand-100">
              بررسی اولیه با اطلاعات دقیق‌تر سریع‌تر انجام
              می‌شود و از تفسیر اشتباه یک کد بدون Context
              جلوگیری می‌کند.
            </p>
          </div>

          <div class="flex shrink-0 flex-wrap gap-3">
            <Button
              href="/request/repair/"
              size="lg"
            >
              درخواست بررسی
            </Button>

            <Button
              href="/services/"
              variant="secondary"
              size="lg"
            >
              مشاهده خدمات
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>