---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";

import Badge from "../../components/common/Badge.astro";
import Button from "../../components/common/Button.astro";
import Card from "../../components/common/Card.astro";

import { siteConfig } from "../../config/site";

import {
  formatRepairDate,
  getActiveRepairs,
  getRepairHref,
  getRepairServiceTitles,
} from "../../lib/repairs";

const allRepairs = await getCollection("repairs");
const repairs = getActiveRepairs(allRepairs);

const siteUrl = siteConfig.seo.siteUrl.replace(/\/$/, "");
const canonical = `${siteUrl}/repairs/`;

const pageTitle = "سوابق تعمیر و عیب‌یابی CNC";

const pageDescription =
  "سوابق منتشرشده تعمیر و عیب‌یابی تجهیزات CNC شامل علائم خرابی، تشخیص فنی، عملیات انجام‌شده، قطعه یا تجهیز مرتبط و نتیجه بررسی.";

const structuredData =
  repairs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "سوابق تعمیر CNC Center",
        itemListElement: repairs.map(
          (repair, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: repair.data.title,
            url: `${siteUrl}${getRepairHref(repair)}`,
          }),
        ),
      }
    : null;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
>
  {
    structuredData && (
      <script
        slot="head"
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      ></script>
    )
  }

  <main>
    <section class="border-b border-line bg-surface-raised py-12 md:py-18">
      <div class="site-container">
        <div class="max-w-4xl">
          <Badge variant="brand">
            سوابق تعمیر CNC
          </Badge>

          <h1 class="mt-5 text-3xl font-black leading-[1.45] tracking-tight text-ink md:text-5xl">
            سوابق تعمیر و عیب‌یابی CNC
          </h1>

          <p class="mt-5 max-w-3xl text-base leading-8 text-muted md:text-lg">
            پروژه‌های منتشرشده تعمیر و عیب‌یابی در این بخش با اطلاعاتی
            مانند نوع دستگاه، تجهیز معیوب، علائم خرابی، تشخیص فنی،
            عملیات انجام‌شده و نتیجه بررسی ثبت می‌شوند.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <Button
              href="/request/repair/"
              size="lg"
            >
              ثبت درخواست تعمیر
            </Button>

            <Button
              href="/services/"
              variant="secondary"
              size="lg"
            >
              مشاهده خدمات تعمیر
            </Button>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-line bg-surface py-10 md:py-12">
      <div class="site-container">
        <div class="max-w-3xl">
          <p class="text-sm font-bold text-brand-700">
            ساختار هر سابقه
          </p>

          <h2 class="mt-2 text-2xl font-black text-ink md:text-3xl">
            مسیر فنی از علامت خرابی تا نتیجه
          </h2>

          <p class="mt-3 text-sm leading-7 text-muted">
            هدف این بخش نمایش مستند و قابل‌فهم مسیر بررسی هر تجهیز است؛
            نه صرفاً فهرست کردن نام دستگاه یا قطعه.
          </p>
        </div>

        <div class="mt-7 grid gap-4 md:grid-cols-3">
          <Card padding="lg">
            <p class="text-sm font-bold text-brand-700">
              01 — علائم و شرایط خرابی
            </p>

            <h3 class="mt-3 text-lg font-black text-ink">
              مسئله چگونه ظاهر شده است؟
            </h3>

            <p class="mt-3 text-sm leading-7 text-muted">
              کد آلارم، رفتار دستگاه، تجهیز درگیر و شرایط ایجاد خطا
              به‌عنوان نقطه شروع ثبت می‌شوند.
            </p>
          </Card>

          <Card padding="lg">
            <p class="text-sm font-bold text-brand-700">
              02 — تشخیص و عملیات
            </p>

            <h3 class="mt-3 text-lg font-black text-ink">
              چه چیزی بررسی شده است؟
            </h3>

            <p class="mt-3 text-sm leading-7 text-muted">
              تشخیص فنی و عملیات انجام‌شده روی کنترلر، درایو،
              موتور، برد یا بخش مکانیکی ثبت می‌شود.
            </p>
          </Card>

          <Card padding="lg">
            <p class="text-sm font-bold text-brand-700">
              03 — نتیجه بررسی
            </p>

            <h3 class="mt-3 text-lg font-black text-ink">
              نتیجه نهایی چه بوده است؟
            </h3>

            <p class="mt-3 text-sm leading-7 text-muted">
              نتیجه تست، وضعیت تجهیز و ارتباط پروژه با خدمات
              یا قطعات مرتبط در انتهای رکورد مشخص می‌شود.
            </p>
          </Card>
        </div>
      </div>
    </section>

    <section class="section-space bg-surface">
      <div class="site-container">
        {
          repairs.length > 0 ? (
            <>
              <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
                <div>
                  <p class="text-sm font-bold text-brand-700">
                    آرشیو منتشرشده
                  </p>

                  <h2 class="mt-2 text-2xl font-black text-ink md:text-3xl">
                    سوابق تعمیر قابل مشاهده
                  </h2>

                  <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">
                    فقط رکوردهای فعال و تأییدشده در این فهرست نمایش داده می‌شوند.
                  </p>
                </div>

                <p class="text-sm font-bold text-muted">
                  {new Intl.NumberFormat("fa-IR").format(repairs.length)}
                  {" "}
                  سابقه
                </p>
              </div>

              <div class="grid gap-6 lg:grid-cols-2">
                {
                  repairs.map((repair) => {
                    const serviceTitles =
                      getRepairServiceTitles(repair);

                    const publishedAt =
                      formatRepairDate(
                        repair.data.publishedAt,
                      );

                    return (
                      <Card
                        interactive={true}
                        class="group flex h-full flex-col"
                      >
                        <div class="flex flex-wrap items-center gap-2">
                          <Badge
                            variant="brand"
                            size="sm"
                          >
                            سابقه تعمیر
                          </Badge>

                          {
                            repair.data.brand && (
                              <span
                                dir="ltr"
                                class="text-xs font-bold text-muted"
                              >
                                {repair.data.brand}
                              </span>
                            )
                          }
                        </div>

                        <h3 class="mt-5 text-xl font-black leading-8 text-ink">
                          {repair.data.title}
                        </h3>

                        <p class="mt-3 flex-1 text-sm leading-7 text-muted">
                          {repair.data.excerpt}
                        </p>

                        <dl class="mt-5 grid gap-3 border-t border-line pt-5 text-sm sm:grid-cols-2">
                          <div>
                            <dt class="font-bold text-muted">
                              دستگاه
                            </dt>

                            <dd class="mt-1 font-bold text-ink">
                              {repair.data.machine}
                            </dd>
                          </div>

                          <div>
                            <dt class="font-bold text-muted">
                              تجهیز
                            </dt>

                            <dd
                              dir="ltr"
                              class="mt-1 text-left font-bold text-ink"
                            >
                              {repair.data.component}
                            </dd>
                          </div>

                          {
                            repair.data.alarmCode && (
                              <div>
                                <dt class="font-bold text-muted">
                                  Alarm
                                </dt>

                                <dd
                                  dir="ltr"
                                  class="mt-1 text-left font-bold text-ink"
                                >
                                  {repair.data.alarmCode}
                                </dd>
                              </div>
                            )
                          }

                          {
                            publishedAt && (
                              <div>
                                <dt class="font-bold text-muted">
                                  تاریخ انتشار
                                </dt>

                                <dd class="mt-1 font-bold text-ink">
                                  {publishedAt}
                                </dd>
                              </div>
                            )
                          }
                        </dl>

                        {
                          serviceTitles.length > 0 && (
                            <div class="mt-5 flex flex-wrap gap-2">
                              {
                                serviceTitles.map(
                                  (serviceTitle) => (
                                    <span class="rounded-full border border-line bg-surface-raised px-3 py-1 text-xs font-bold text-muted">
                                      {serviceTitle}
                                    </span>
                                  ),
                                )
                              }
                            </div>
                          )
                        }

                        <a
                          href={getRepairHref(repair)}
                          class="mt-6 inline-flex min-h-10 items-center text-sm font-bold text-brand-700 transition hover:text-brand-900"
                          aria-label={`مشاهده سابقه تعمیر: ${repair.data.title}`}
                        >
                          مشاهده جزئیات سابقه
                        </a>
                      </Card>
                    );
                  })
                }
              </div>
            </>
          ) : (
            <div class="mx-auto max-w-3xl rounded-panel border border-line bg-surface-raised p-8 text-center shadow-card md:p-12">
              <div
                aria-hidden="true"
                class="mx-auto grid size-14 place-items-center rounded-full bg-brand-50 text-sm font-black text-brand-800"
              >
                CNC
              </div>

              <h2 class="mt-5 text-2xl font-black text-ink">
                آرشیو سوابق تعمیر در حال آماده‌سازی است
              </h2>

              <p class="mx-auto mt-3 max-w-xl text-sm leading-8 text-muted">
                هنوز سابقه تعمیر فعال و عمومی در سایت منتشر نشده است.
                رکوردهای این بخش پس از تکمیل اطلاعات فنی و مستندات پروژه
                منتشر خواهند شد.
              </p>

              <div class="mt-6 flex flex-wrap justify-center gap-3">
                <Button href="/request/repair/">
                  ثبت درخواست تعمیر
                </Button>

                <Button
                  href="/services/"
                  variant="secondary"
                >
                  مشاهده خدمات
                </Button>
              </div>
            </div>
          )
        }
      </div>
    </section>

    <section class="border-t border-line bg-surface-raised py-10 md:py-12">
      <div class="site-container">
        <div class="grid gap-4 md:grid-cols-3">
          <div class="rounded-card border border-line bg-surface p-5">
            <p class="text-sm font-bold text-brand-700">
              بررسی اولیه
            </p>

            <p class="mt-2 font-black text-ink">
              مدل، Part Number و Alarm
            </p>

            <p class="mt-2 text-sm leading-7 text-muted">
              برای شروع بررسی، اطلاعات تجهیز و کد خطا تا حد امکان ثبت می‌شود.
            </p>
          </div>

          <div class="rounded-card border border-line bg-surface p-5">
            <p class="text-sm font-bold text-brand-700">
              ارتباط با خدمات
            </p>

            <p class="mt-2 font-black text-ink">
              مسیر تعمیر متناسب با خرابی
            </p>

            <p class="mt-2 text-sm leading-7 text-muted">
              هر پروژه می‌تواند به سروو، کنترل، اسپیندل، الکترونیک،
              مکانیک یا تشخیص آلارم مرتبط باشد.
            </p>
          </div>

          <div class="rounded-card border border-line bg-surface p-5">
            <p class="text-sm font-bold text-brand-700">
              پوشش سراسری
            </p>

            <p class="mt-2 font-black text-ink">
              پذیرش بررسی از سراسر ایران
            </p>

            <p class="mt-2 text-sm leading-7 text-muted">
              امکان هماهنگی برای ارسال تجهیز یا بررسی شرایط پروژه
              بر اساس نوع دستگاه و خرابی وجود دارد.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>