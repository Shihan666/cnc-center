---
import {
  getCollection,
  render,
} from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import KnowledgeBacklinks from "../../components/knowledge/KnowledgeBacklinks.astro";

import Badge from "../../components/common/Badge.astro";
import Button from "../../components/common/Button.astro";
import Card from "../../components/common/Card.astro";
import ProductCard from "../../components/product/ProductCard.astro";

import { siteConfig } from "../../config/site";
import { serviceCategories } from "../../data/serviceCategories";

import {
  getActiveBrands,
  getBrandHref,
} from "../../lib/brands";

import {
  getActiveProducts,
} from "../../lib/products";

import {
  getCommerceProductsByContentIds,
} from "../../server/products/commerce-repository";

import {
  formatRepairDate,
  getActiveRepairs,
  type RepairEntry,
} from "../../lib/repairs";

import {
  getRelatedActiveArticlesForEntity,
  getRelatedActiveFaqsForEntity,
} from "../../lib/knowledgeGraph";

export const prerender = true;

export async function getStaticPaths() {
  const allRepairs = await getCollection("repairs");
  const repairs = getActiveRepairs(allRepairs);

  return repairs.map((repair) => ({
    params: {
      id: repair.id,
    },

    props: {
      repair,
    },
  }));
}

interface Props {
  repair: RepairEntry;
}

const { repair } = Astro.props;

const { Content } = await render(repair);

const [
  allKnowledgeArticles,
  allKnowledgeFaqs,
] = await Promise.all([
  getCollection("articles"),
  getCollection("faqs"),
]);

const relatedKnowledgeArticles =
  getRelatedActiveArticlesForEntity(
    allKnowledgeArticles,
    "repair",
    repair.id,
  );

const relatedKnowledgeFaqs =
  getRelatedActiveFaqsForEntity(
    allKnowledgeFaqs,
    "repair",
    repair.id,
  );

const allBrands = await getCollection("brands");
const activeBrands = getActiveBrands(allBrands);

const allProducts = await getCollection("products");
const activeProducts = getActiveProducts(allProducts);

const commerceStates =
  await getCommerceProductsByContentIds(
    activeProducts.map(
      (product) =>
        product.id,
    ),
  );

const commerceByContentId =
  new Map(
    commerceStates.map(
      (state) => [
        state.contentId,
        state,
      ],
    ),
  );

const relatedBrandIds = new Set(
  repair.data.relatedBrands,
);

const relatedBrands = activeBrands.filter((brand) =>
  relatedBrandIds.has(brand.id),
);

const relatedProductIds = new Set(
  repair.data.relatedProducts,
);

const relatedProducts = activeProducts.filter((product) =>
  relatedProductIds.has(product.id),
);

const relatedServices = repair.data.relatedServices
  .map((serviceId) =>
    serviceCategories.find(
      (service) => service.id === serviceId,
    ),
  )
  .filter(
    (
      service,
    ): service is (typeof serviceCategories)[number] =>
      service !== undefined,
  );

const siteUrl = siteConfig.seo.siteUrl.replace(/\/$/, "");

const canonical =
  repair.data.seo?.canonical ??
  `${siteUrl}/repairs/${repair.id}/`;

const pageTitle =
  repair.data.seo?.title ??
  repair.data.title;

const pageDescription =
  repair.data.seo?.description ??
  repair.data.excerpt;

const noindex =
  repair.data.seo?.noindex ?? false;

const publishedAt =
  formatRepairDate(repair.data.publishedAt);

const completedAt =
  formatRepairDate(repair.data.completedAt);

const structuredImages = [
  ...repair.data.beforeImages,
  ...repair.data.afterImages,
].map((image) =>
  image.startsWith("http")
    ? image
    : `${siteUrl}${image}`,
);

const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: repair.data.title,
  description: repair.data.excerpt,
  url: canonical,
  inLanguage: "fa-IR",

  ...(repair.data.publishedAt
    ? {
        datePublished:
          repair.data.publishedAt.toISOString(),
      }
    : {}),

  ...(structuredImages.length > 0
    ? {
        image: structuredImages,
      }
    : {}),

  publisher: {
    "@type": "Organization",
    name: siteConfig.brand.name,
    url: siteUrl,
  },

  about: [
    {
      "@type": "Thing",
      name: repair.data.machine,
    },
    {
      "@type": "Thing",
      name: repair.data.component,
    },

    ...(repair.data.brand
      ? [
          {
            "@type": "Brand",
            name: repair.data.brand,
          },
        ]
      : []),
  ],
};

const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",

  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "صفحه اصلی",
      item: `${siteUrl}/`,
    },

    {
      "@type": "ListItem",
      position: 2,
      name: "سوابق تعمیر",
      item: `${siteUrl}/repairs/`,
    },

    {
      "@type": "ListItem",
      position: 3,
      name: repair.data.title,
      item: canonical,
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  noindex={noindex}
>
  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(articleStructuredData)}
  ></script>

  <script
    slot="head"
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbStructuredData)}
  ></script>

  <main>
    <section class="border-b border-line bg-surface-raised py-10 md:py-14">
      <div class="site-container">
        <nav
          aria-label="مسیر صفحه"
          class="mb-7 flex flex-wrap items-center gap-2 text-xs text-muted"
        >
          <a
            href="/"
            class="transition hover:text-brand-700"
          >
            صفحه اصلی
          </a>

          <span aria-hidden="true">/</span>

          <a
            href="/repairs/"
            class="transition hover:text-brand-700"
          >
            سوابق تعمیر
          </a>

          <span aria-hidden="true">/</span>

          <span class="font-bold text-ink-soft">
            {repair.data.title}
          </span>
        </nav>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
          <div>
            <div class="flex flex-wrap gap-2">
              <Badge
                variant="brand"
                size="sm"
              >
                سابقه تعمیر CNC
              </Badge>

              {
                repair.data.brand && (
                  <Badge
                    variant="neutral"
                    size="sm"
                    dir="ltr"
                  >
                    {repair.data.brand}
                  </Badge>
                )
              }

              {
                repair.data.alarmCode && (
                  <Badge
                    variant="warning"
                    size="sm"
                    dir="ltr"
                  >
                    {repair.data.alarmCode}
                  </Badge>
                )
              }
            </div>

            <h1 class="mt-5 text-3xl font-black leading-[1.55] tracking-tight text-ink md:text-5xl">
              {repair.data.title}
            </h1>

            <p class="mt-5 max-w-3xl text-base leading-8 text-muted md:text-lg">
              {repair.data.excerpt}
            </p>

            <div class="mt-7 flex flex-wrap gap-3">
              <Button
                href="/request/repair/"
                size="lg"
              >
                ثبت درخواست تعمیر
              </Button>

              <Button
                href="/repairs/"
                variant="secondary"
                size="lg"
              >
                بازگشت به سوابق تعمیر
              </Button>
            </div>
          </div>

          <Card padding="lg">
            <p class="text-sm font-bold text-brand-700">
              خلاصه پروژه
            </p>

            <dl class="mt-5 space-y-4">
              <div>
                <dt class="text-xs font-bold text-muted">
                  دستگاه
                </dt>

                <dd class="mt-1 text-sm font-black leading-7 text-ink">
                  {repair.data.machine}
                </dd>
              </div>

              <div>
                <dt class="text-xs font-bold text-muted">
                  تجهیز
                </dt>

                <dd
                  dir="auto"
                  class="mt-1 text-sm font-black text-ink"
                >
                  {repair.data.component}
                </dd>
              </div>

              {
                completedAt && (
                  <div>
                    <dt class="text-xs font-bold text-muted">
                      تاریخ تکمیل
                    </dt>

                    <dd class="mt-1 text-sm font-black text-ink">
                      {completedAt}
                    </dd>
                  </div>
                )
              }

              {
                publishedAt && (
                  <div>
                    <dt class="text-xs font-bold text-muted">
                      تاریخ انتشار
                    </dt>

                    <dd class="mt-1 text-sm font-black text-ink">
                      {publishedAt}
                    </dd>
                  </div>
                )
              }
            </dl>
          </Card>
        </div>
      </div>
    </section>

    <section class="border-b border-line bg-surface py-10 md:py-12">
      <div class="site-container">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {
            repair.data.manufacturer && (
              <Card padding="sm">
                <p class="text-xs font-bold text-muted">
                  سازنده دستگاه
                </p>

                <p
                  dir="auto"
                  class="mt-2 text-sm font-black text-ink"
                >
                  {repair.data.manufacturer}
                </p>
              </Card>
            )
          }

          {
            repair.data.machineModel && (
              <Card padding="sm">
                <p class="text-xs font-bold text-muted">
                  مدل دستگاه
                </p>

                <p
                  dir="auto"
                  class="mt-2 text-sm font-black text-ink"
                >
                  {repair.data.machineModel}
                </p>
              </Card>
            )
          }

          {
            repair.data.controller && (
              <Card padding="sm">
                <p class="text-xs font-bold text-muted">
                  کنترلر
                </p>

                <p
                  dir="auto"
                  class="mt-2 text-sm font-black text-ink"
                >
                  {repair.data.controller}
                </p>
              </Card>
            )
          }

          {
            repair.data.partNumber && (
              <Card padding="sm">
                <p class="text-xs font-bold text-muted">
                  Part Number
                </p>

                <p
                  dir="ltr"
                  class="mt-2 break-words text-left text-sm font-black text-ink"
                >
                  {repair.data.partNumber}
                </p>
              </Card>
            )
          }
        </div>
      </div>
    </section>

    <section class="section-space bg-surface">
      <div class="site-container">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px]">
          <div class="space-y-6">
            {
              repair.data.problemSymptoms.length > 0 && (
                <Card padding="lg">
                  <p class="text-sm font-bold text-brand-700">
                    مرحله 01
                  </p>

                  <h2 class="mt-2 text-2xl font-black text-ink">
                    علائم و شرایط خرابی
                  </h2>

                  <ul class="mt-6 space-y-3">
                    {
                      repair.data.problemSymptoms.map(
                        (symptom) => (
                          <li class="flex gap-3 text-sm leading-7 text-ink-soft">
                            <span
                              aria-hidden="true"
                              class="mt-1 grid size-5 shrink-0 place-items-center rounded-full bg-brand-50 text-xs font-black text-brand-800"
                            >
                              !
                            </span>

                            <span>{symptom}</span>
                          </li>
                        ),
                      )
                    }
                  </ul>
                </Card>
              )
            }

            <Card padding="lg">
              <p class="text-sm font-bold text-brand-700">
                مرحله 02
              </p>

              <h2 class="mt-2 text-2xl font-black text-ink">
                تشخیص فنی
              </h2>

              <p class="mt-5 text-sm leading-8 text-ink-soft">
                {repair.data.diagnosis}
              </p>
            </Card>

            <Card padding="lg">
              <p class="text-sm font-bold text-brand-700">
                مرحله 03
              </p>

              <h2 class="mt-2 text-2xl font-black text-ink">
                عملیات تعمیر و بررسی
              </h2>

              <p class="mt-5 text-sm leading-8 text-ink-soft">
                {repair.data.repairOperation}
              </p>
            </Card>

            <Card padding="lg">
              <p class="text-sm font-bold text-brand-700">
                مرحله 04
              </p>

              <h2 class="mt-2 text-2xl font-black text-ink">
                نتیجه
              </h2>

              <p class="mt-5 text-sm leading-8 text-ink-soft">
                {repair.data.result}
              </p>
            </Card>

            <Card padding="lg">
              <h2 class="text-2xl font-black text-ink">
                توضیحات تکمیلی پروژه
              </h2>

              <div class="prose-content mt-6">
                <Content />
              </div>
            </Card>
          </div>

          <aside class="space-y-6">
            {
              repair.data.alarmCode && (
                <Card>
                  <p class="text-sm font-bold text-brand-700">
                    کد آلارم
                  </p>

                  <p
                    dir="ltr"
                    class="mt-3 break-words text-left text-lg font-black text-ink"
                  >
                    {repair.data.alarmCode}
                  </p>

                  <p class="mt-3 text-xs leading-6 text-muted">
                    تفسیر کد آلارم باید همراه با مدل کنترلر،
                    درایو یا تجهیز و شرایط ایجاد خطا انجام شود.
                  </p>
                </Card>
              )
            }

            {
              relatedServices.length > 0 && (
                <Card>
                  <p class="text-sm font-bold text-brand-700">
                    خدمات مرتبط
                  </p>

                  <div class="mt-4 space-y-2">
                    {
                      relatedServices.map((service) => (
                        <a
                          href={`/services/${service.id}/`}
                          class="block rounded-control border border-line px-4 py-3 text-sm font-bold text-ink transition hover:border-brand-200 hover:text-brand-700"
                        >
                          {service.title}
                        </a>
                      ))
                    }
                  </div>
                </Card>
              )
            }

            {
              relatedBrands.length > 0 && (
                <Card>
                  <p class="text-sm font-bold text-brand-700">
                    برندهای مرتبط
                  </p>

                  <div class="mt-4 space-y-2">
                    {
                      relatedBrands.map((brand) => (
                        <a
                          href={getBrandHref(brand)}
                          class="block rounded-control border border-line px-4 py-3 text-sm font-bold text-ink transition hover:border-brand-200 hover:text-brand-700"
                        >
                          <span dir="ltr">
                            {brand.data.name}
                          </span>
                        </a>
                      ))
                    }
                  </div>
                </Card>
              )
            }

            <Card>
              <p class="text-sm font-bold text-brand-700">
                پروژه مشابه دارید؟
              </p>

              <p class="mt-3 text-sm leading-7 text-muted">
                مدل دستگاه، Part Number، کد آلارم و شرح اتفاق
                قبل از خرابی را برای بررسی اولیه ارسال کنید.
              </p>

              <div class="mt-5">
                <Button
                  href="/request/repair/"
                  class="w-full"
                >
                  درخواست بررسی تعمیر
                </Button>
              </div>
            </Card>
          </aside>
        </div>
      </div>
    </section>

    {
      (repair.data.beforeImages.length > 0 ||
        repair.data.afterImages.length > 0) && (
        <section class="border-t border-line bg-surface-raised py-10 md:py-14">
          <div class="site-container">
            <div>
              <p class="text-sm font-bold text-brand-700">
                مستندات تصویری
              </p>

              <h2 class="mt-2 text-2xl font-black text-ink md:text-3xl">
                تصاویر قبل و بعد از تعمیر
              </h2>
            </div>

            <div class="mt-8 grid gap-8 lg:grid-cols-2">
              {
                repair.data.beforeImages.length > 0 && (
                  <div>
                    <h3 class="text-lg font-black text-ink">
                      قبل از تعمیر
                    </h3>

                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                      {
                        repair.data.beforeImages.map(
                          (image, index) => (
                            <div class="overflow-hidden rounded-card border border-line bg-surface">
                              <img
                                src={image}
                                alt={`قبل از تعمیر - ${repair.data.title} - تصویر ${index + 1}`}
                                loading="lazy"
                                class="aspect-[4/3] h-full w-full object-cover"
                              />
                            </div>
                          ),
                        )
                      }
                    </div>
                  </div>
                )
              }

              {
                repair.data.afterImages.length > 0 && (
                  <div>
                    <h3 class="text-lg font-black text-ink">
                      بعد از تعمیر
                    </h3>

                    <div class="mt-4 grid gap-4 sm:grid-cols-2">
                      {
                        repair.data.afterImages.map(
                          (image, index) => (
                            <div class="overflow-hidden rounded-card border border-line bg-surface">
                              <img
                                src={image}
                                alt={`بعد از تعمیر - ${repair.data.title} - تصویر ${index + 1}`}
                                loading="lazy"
                                class="aspect-[4/3] h-full w-full object-cover"
                              />
                            </div>
                          ),
                        )
                      }
                    </div>
                  </div>
                )
              }
            </div>
          </div>
        </section>
      )
    }

    {
      relatedProducts.length > 0 && (
        <section class="border-t border-line bg-surface py-10 md:py-14">
          <div class="site-container">
            <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
              <div>
                <p class="text-sm font-bold text-brand-700">
                  قطعات مرتبط
                </p>

                <h2 class="mt-2 text-2xl font-black text-ink">
                  محصولات مرتبط با این سابقه
                </h2>
              </div>

              <p class="text-sm font-bold text-muted">
                {new Intl.NumberFormat("fa-IR").format(
                  relatedProducts.length,
                )}
                {" "}
                محصول
              </p>
            </div>

            <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
              {
                relatedProducts.map((product) => (
                  <ProductCard
  product={product}
  commerce={commerceByContentId.get(product.id)!}
/>
                ))
              }
            </div>
          </div>
        </section>
      )
    }

    <KnowledgeBacklinks
      articles={relatedKnowledgeArticles}
      faqs={relatedKnowledgeFaqs}
    />

    <section class="border-t border-line bg-brand-950 py-10 text-white md:py-12">
      <div class="site-container">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-3xl">
            <p class="text-sm font-bold text-brand-200">
              دستگاه یا تجهیز مشابهی دارید؟
            </p>

            <h2 class="mt-2 text-2xl font-black md:text-3xl">
              مشخصات فنی و علائم خرابی را برای بررسی ارسال کنید
            </h2>

            <p class="mt-3 text-sm leading-7 text-brand-100">
              مدل دستگاه، برند، Part Number و Alarm به انتخاب
              مسیر صحیح عیب‌یابی و تعمیر کمک می‌کند.
            </p>
          </div>

          <div class="flex shrink-0 flex-wrap gap-3">
            <Button
              href="/request/repair/"
              size="lg"
            >
              درخواست تعمیر
            </Button>

            <Button
              href="/services/"
              variant="secondary"
              size="lg"
            >
              خدمات CNC
            </Button>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>