---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/home/HeroSection.astro";
import QuickActions from "../components/home/QuickActions.astro";
import HomeServices from "../components/home/HomeServices.astro";
import HomeShopCategories from "../components/home/HomeShopCategories.astro";
import HomeBrands from "../components/home/HomeBrands.astro";
import HomeWhyProcess from "../components/home/HomeWhyProcess.astro";
import HomeNationwide from "../components/home/HomeNationwide.astro";
import HomeFinalCta from "../components/home/HomeFinalCta.astro";
import { siteConfig } from "../config/site";

const siteUrl =
  siteConfig.seo.siteUrl.replace(/\/$/, "");

const canonical =
  `${siteUrl}/`;
---

<BaseLayout canonical={canonical}>
  <main>
    <HeroSection />
    <QuickActions />
    <HomeServices />
    <HomeShopCategories />
    <HomeBrands />
    <HomeWhyProcess />
    <HomeNationwide />
    <HomeFinalCta />
  </main>
</BaseLayout>
