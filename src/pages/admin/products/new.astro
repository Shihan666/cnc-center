---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Button from "../../../components/common/Button.astro";
import Card from "../../../components/common/Card.astro";

const inputClass =
  "min-h-11 w-full rounded-control border border-line-strong bg-surface-raised px-3.5 text-sm text-ink outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100";

const labelClass =
  "mb-2 block text-sm font-semibold text-ink";
---

<AdminLayout title="افزودن محصول">
  <div class="space-y-6">
    <section
      class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between"
      aria-labelledby="new-product-heading"
    >
      <div class="max-w-2xl">
        <a
          href="/admin/products"
          class="text-sm font-bold text-brand-700 transition hover:text-brand-800"
        >
          بازگشت به محصولات
        </a>

        <h2
          id="new-product-heading"
          class="mt-3 text-2xl font-black text-ink"
        >
          افزودن محصول
        </h2>

        <p class="mt-2 text-sm leading-6 text-muted">
          اطلاعات پایه و وضعیت تجاری محصول را ثبت کنید. موجودی اولیه صفر است و بعداً از صفحه محصول قابل تنظیم خواهد بود.
        </p>
      </div>
    </section>

    <form
      id="create-product-form"
      class="space-y-6"
      novalidate
    >
      <Card
        as="section"
        padding="md"
        class="shadow-none"
      >
        <div>
          <h3 class="text-lg font-black text-ink">
            اطلاعات اصلی
          </h3>

          <p class="mt-1 text-sm leading-6 text-muted">
            شناسه محتوا باید با محتوای عمومی محصول هماهنگ باشد.
          </p>
        </div>

        <div class="mt-5 grid gap-5 md:grid-cols-2">
          <div>
            <label
              for="product-name"
              class={labelClass}
            >
              نام محصول
            </label>

            <input
              id="product-name"
              name="name"
              type="text"
              maxlength="500"
              required
              autocomplete="off"
              class={inputClass}
            />
          </div>

          <div>
            <label
              for="product-brand"
              class={labelClass}
            >
              برند
            </label>

            <input
              id="product-brand"
              name="brand"
              type="text"
              maxlength="500"
              required
              autocomplete="off"
              class={inputClass}
            />
          </div>

          <div>
            <label
              for="product-part-number"
              class={labelClass}
            >
              کد فنی / Part Number
            </label>

            <input
              id="product-part-number"
              name="partNumber"
              type="text"
              maxlength="500"
              required
              autocomplete="off"
              dir="ltr"
              class={inputClass}
            />
          </div>

          <div>
            <label
              for="product-sku"
              class={labelClass}
            >
              SKU
              <span class="font-normal text-muted">
                (اختیاری)
              </span>
            </label>

            <input
              id="product-sku"
              name="sku"
              type="text"
              maxlength="200"
              autocomplete="off"
              dir="ltr"
              class={inputClass}
            />
          </div>

          <div>
            <label
              for="product-manufacturer"
              class={labelClass}
            >
              سازنده
              <span class="font-normal text-muted">
                (اختیاری)
              </span>
            </label>

            <input
              id="product-manufacturer"
              name="manufacturer"
              type="text"
              maxlength="500"
              autocomplete="off"
              class={inputClass}
            />
          </div>

          <div>
            <label
              for="product-content-id"
              class={labelClass}
            >
              Content ID
            </label>

            <input
              id="product-content-id"
              name="contentId"
              type="text"
              maxlength="500"
              required
              autocomplete="off"
              dir="ltr"
              class={inputClass}
            />

            <p class="mt-1.5 text-xs leading-5 text-muted">
              این مقدار کلید اتصال محصول دیتابیس به محتوای سایت است.
            </p>
          </div>
        </div>
      </Card>

      <Card
        as="section"
        padding="md"
        class="shadow-none"
      >
        <div>
          <h3 class="text-lg font-black text-ink">
            وضعیت و فروش
          </h3>

          <p class="mt-1 text-sm leading-6 text-muted">
            روش فروش، نمایش قیمت، ارسال و وضعیت انتشار محصول را تعیین کنید.
          </p>
        </div>

        <div class="mt-5 grid gap-5 md:grid-cols-2">
          <div>
            <label
              for="product-condition"
              class={labelClass}
            >
              وضعیت کالا
            </label>

            <select
              id="product-condition"
              name="condition"
              required
              class={inputClass}
            >
              <option value="new">نو</option>
              <option value="used">کارکرده</option>
              <option value="refurbished">
                بازسازی‌شده
              </option>
              <option value="tested">تست‌شده</option>
            </select>
          </div>

          <div>
            <label
              for="product-commerce-mode"
              class={labelClass}
            >
              روش فروش
            </label>

            <select
              id="product-commerce-mode"
              name="commerceMode"
              required
              class={inputClass}
            >
              <option value="direct-purchase">
                خرید مستقیم
              </option>
              <option value="price-inquiry">
                استعلام قیمت
              </option>
              <option value="sourcing-request">
                درخواست تأمین
              </option>
            </select>
          </div>

          <div>
            <label
              for="product-price-visibility"
              class={labelClass}
            >
              نمایش قیمت
            </label>

            <select
              id="product-price-visibility"
              name="priceVisibility"
              required
              class={inputClass}
            >
              <option value="visible">
                قابل نمایش
              </option>
              <option value="hidden">
                مخفی
              </option>
            </select>
          </div>

          <div>
            <label
              for="product-shipping-class"
              class={labelClass}
            >
              روش / کلاس ارسال
            </label>

            <select
              id="product-shipping-class"
              name="shippingClass"
              required
              class={inputClass}
            >
              <option value="standard">
                استاندارد
              </option>
              <option value="fragile">
                شکستنی
              </option>
              <option value="heavy">
                سنگین
              </option>
              <option value="pickup-only">
                فقط تحویل حضوری
              </option>
              <option value="custom">
                سفارشی
              </option>
            </select>
          </div>

          <div>
            <label
              for="product-status"
              class={labelClass}
            >
              وضعیت محصول
            </label>

            <select
              id="product-status"
              name="status"
              required
              class={inputClass}
            >
              <option value="draft">
                پیش‌نویس
              </option>
              <option value="active">
                فعال
              </option>
              <option value="archived">
                بایگانی‌شده
              </option>
            </select>
          </div>

          <div>
            <label
              for="product-price"
              class={labelClass}
            >
              قیمت اولیه
              <span class="font-normal text-muted">
                (ریال، اختیاری)
              </span>
            </label>

            <input
              id="product-price"
              name="priceRial"
              type="number"
              min="0"
              step="1"
              inputmode="numeric"
              dir="ltr"
              class={inputClass}
            />

            <p class="mt-1.5 text-xs leading-5 text-muted">
              اگر خالی بماند، محصول بدون قیمت اولیه ساخته می‌شود.
            </p>
          </div>
        </div>
      </Card>

      <div
        id="product-form-error"
        class="hidden rounded-control border border-danger-200 bg-danger-50 px-4 py-3 text-sm font-semibold text-danger-700"
        role="alert"
        aria-live="polite"
      ></div>

      <div
        class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
      >
        <Button
          href="/admin/products"
          variant="secondary"
        >
          انصراف
        </Button>

        <Button
          type="submit"
          variant="primary"
        >
          ذخیره محصول
        </Button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const form =
    document.querySelector<HTMLFormElement>(
      "#create-product-form",
    );

  const submitButton =
    form?.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    ) ?? null;

  const errorBox =
    document.querySelector<HTMLElement>(
      "#product-form-error",
    );

  function showError(message: string) {
    if (!errorBox) {
      return;
    }

    errorBox.textContent = message;
    errorBox.classList.remove("hidden");
  }

  function clearError() {
    if (!errorBox) {
      return;
    }

    errorBox.textContent = "";
    errorBox.classList.add("hidden");
  }

  function readText(
    data: FormData,
    name: string,
  ): string {
    const value = data.get(name);

    return typeof value === "string"
      ? value
      : "";
  }

  form?.addEventListener(
    "submit",
    async (event) => {
      event.preventDefault();
      clearError();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const formData =
        new FormData(form);

      const rawPrice =
        readText(
          formData,
          "priceRial",
        ).trim();

      let priceRial: number | null =
        null;

      if (rawPrice) {
        const parsedPrice =
          Number(rawPrice);

        if (
          !Number.isSafeInteger(parsedPrice) ||
          parsedPrice < 0
        ) {
          showError(
            "قیمت باید یک عدد صحیح نامنفی و معتبر بر حسب ریال باشد.",
          );
          return;
        }

        priceRial = parsedPrice;
      }

      const payload = {
        contentId:
          readText(
            formData,
            "contentId",
          ),
        sku:
          readText(
            formData,
            "sku",
          ),
        partNumber:
          readText(
            formData,
            "partNumber",
          ),
        name:
          readText(
            formData,
            "name",
          ),
        brand:
          readText(
            formData,
            "brand",
          ),
        manufacturer:
          readText(
            formData,
            "manufacturer",
          ),
        condition:
          readText(
            formData,
            "condition",
          ),
        commerceMode:
          readText(
            formData,
            "commerceMode",
          ),
        priceVisibility:
          readText(
            formData,
            "priceVisibility",
          ),
        shippingClass:
          readText(
            formData,
            "shippingClass",
          ),
        status:
          readText(
            formData,
            "status",
          ),
        priceRial,
      };

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.setAttribute(
          "aria-busy",
          "true",
        );
        submitButton.textContent =
          "در حال ذخیره...";
      }

      try {
        const response =
          await fetch(
            "/api/admin/products",
            {
              method: "POST",
              credentials: "same-origin",
              headers: {
                "Content-Type":
                  "application/json",
              },
              body:
                JSON.stringify(
                  payload,
                ),
            },
          );

        const result =
          await response
            .json()
            .catch(() => null);

        if (
          response.ok &&
          result?.ok === true &&
          typeof result.product?.id ===
            "string"
        ) {
          window.location.replace(
            `/admin/products/${encodeURIComponent(
              result.product.id,
            )}`,
          );

          return;
        }

        if (
          response.status === 409 &&
          result?.reason ===
            "product_conflict"
        ) {
          showError(
            "محصولی با این Content ID یا SKU از قبل وجود دارد.",
          );

          return;
        }

        if (
          response.status === 400 &&
          result?.reason ===
            "invalid_product"
        ) {
          showError(
            "اطلاعات محصول معتبر نیست. فیلدهای الزامی و مقادیر انتخاب‌شده را بررسی کنید.",
          );

          return;
        }

        if (response.status === 401) {
          showError(
            "نشست مدیریت معتبر نیست. دوباره وارد پنل مدیریت شوید.",
          );

          return;
        }

        showError(
          "ذخیره محصول انجام نشد. دوباره تلاش کنید.",
        );
      } catch {
        showError(
          "ارتباط با سرور برقرار نشد. دوباره تلاش کنید.",
        );
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.removeAttribute(
            "aria-busy",
          );
          submitButton.textContent =
            "ذخیره محصول";
        }
      }
    },
  );
</script>