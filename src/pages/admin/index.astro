---
import AdminLayout from "../../layouts/AdminLayout.astro";
import Badge from "../../components/common/Badge.astro";
import Button from "../../components/common/Button.astro";
import Card from "../../components/common/Card.astro";
import EmptyState from "../../components/common/EmptyState.astro";
import { formatRialAmount } from "../../lib/cart";

type OrderStatus =
  | "pending"
  | "awaiting_payment"
  | "paid"
  | "processing"
  | "ready_to_ship"
  | "shipped"
  | "completed"
  | "cancelled"
  | "expired";

type AdminDashboardRecentOrder = {
  id: string;
  orderNumber: string;
  status: OrderStatus;
  customerName: string;
  totalRial: number | null;
  currency: string;
  createdAt: string;
};

type AdminDashboardData = {
  actions: {
    readyToShip: number;
    needsProcessing: number;
    outOfStock: number;
  };
  today: {
    newOrders: number;
    readyToShip: number;
    shipped: number;
  };
  recentOrders: AdminDashboardRecentOrder[];
};

type AdminDashboardResponse = {
  ok: boolean;
  dashboard?: AdminDashboardData;
};

const apiUrl =
  new URL(
    "/api/admin/dashboard",
    Astro.request.url,
  );

const response =
  await fetch(
    apiUrl,
    {
      headers: {
        cookie:
          Astro.request.headers.get(
            "cookie",
          ) ?? "",
      },
    },
  );

let data:
  AdminDashboardResponse |
  null =
  null;

try {
  data =
    await response.json();
} catch {
  data =
    null;
}

const hasDashboardError =
  !response.ok ||
  data?.ok !== true ||
  !data.dashboard;

const dashboard =
  !hasDashboardError
    ? data?.dashboard ?? null
    : null;

const actionItems = [
  {
    label: "آماده ارسال",
    description: "سفارش‌هایی که اکنون در وضعیت آماده ارسال هستند",
    href: "/admin/orders",
    tone: "brand",
    count:
      dashboard?.actions.readyToShip ??
      null,
  },
  {
    label: "نیازمند پردازش",
    description: "سفارش‌های پرداخت‌شده‌ای که باید وارد مرحله پردازش شوند",
    href: "/admin/orders",
    tone: "warning",
    count:
      dashboard?.actions.needsProcessing ??
      null,
  },
  {
    label: "ناموجود",
    description: "محصولاتی که موجودی فیزیکی آن‌ها صفر است",
    href: "/admin/inventory",
    tone: "danger",
    count:
      dashboard?.actions.outOfStock ??
      null,
  },
] as const;

const todayItems = [
  {
    label: "سفارش جدید امروز",
    description: "سفارش‌های ثبت‌شده در روز جاری تهران",
    count:
      dashboard?.today.newOrders ??
      null,
  },
  {
    label: "آماده ارسال امروز",
    description: "سفارش‌هایی که امروز به وضعیت آماده ارسال رسیده‌اند",
    count:
      dashboard?.today.readyToShip ??
      null,
  },
  {
    label: "ارسال‌شده امروز",
    description: "سفارش‌هایی که امروز به وضعیت ارسال‌شده رسیده‌اند",
    count:
      dashboard?.today.shipped ??
      null,
  },
] as const;

const recentOrders:
  AdminDashboardRecentOrder[] =
  dashboard?.recentOrders ?? [];

const statusLabels:
  Record<OrderStatus, string> = {
    pending: "در انتظار بررسی",
    awaiting_payment: "در انتظار پرداخت",
    paid: "پرداخت شده",
    processing: "در حال آماده‌سازی",
    ready_to_ship: "آماده ارسال",
    shipped: "ارسال شده",
    completed: "تکمیل شده",
    cancelled: "لغو شده",
    expired: "منقضی شده",
  };

function formatCount(
  count: number | null,
): string {
  return count === null
    ? "—"
    : count.toLocaleString("fa-IR");
}
---

<AdminLayout title="داشبورد">
  <div class="space-y-8">
    <section aria-labelledby="dashboard-action-title">
      <div
        class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <h2
            id="dashboard-action-title"
            class="text-lg font-black text-ink"
          >
            نیازمند اقدام
          </h2>

          <p class="mt-1 text-sm leading-6 text-muted">
            مهم‌ترین مواردی که اکنون نیاز به اقدام ادمین دارند.
          </p>
        </div>

        <Badge
          variant={hasDashboardError ? "danger" : "neutral"}
          size="sm"
        >
          {hasDashboardError ? "خطا در دریافت داده" : "داده زنده"}
        </Badge>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {
          actionItems.map((item) => (
            <a
              href={item.href}
              class="group block rounded-card focus-visible:outline-none"
            >
              <Card
                as="div"
                padding="md"
                interactive
                class="h-full shadow-none"
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0">
                    <p class="font-bold text-ink">
                      {item.label}
                    </p>

                    <p class="mt-2 text-sm leading-6 text-muted">
                      {item.description}
                    </p>
                  </div>

                  <Badge
                    variant={item.tone}
                    size="sm"
                    class="shrink-0"
                  >
                    {formatCount(item.count)}
                  </Badge>
                </div>

                <p
                  class="mt-5 text-sm font-semibold text-brand-700 transition group-hover:text-brand-800"
                >
                  مشاهده
                </p>
              </Card>
            </a>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="dashboard-today-title">
      <div class="mb-4">
        <h2
          id="dashboard-today-title"
          class="text-lg font-black text-ink"
        >
          امروز
        </h2>

        <p class="mt-1 text-sm leading-6 text-muted">
          نمای سریع رویدادهای روز جاری بر اساس منطقه زمانی تهران.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        {
          todayItems.map((item) => (
            <Card
              as="div"
              padding="md"
              class="shadow-none"
            >
              <p class="text-sm font-semibold text-muted">
                {item.label}
              </p>

              <p class="mt-3 text-2xl font-black text-ink">
                {formatCount(item.count)}
              </p>

              <p class="mt-2 text-sm leading-6 text-muted">
                {item.description}
              </p>
            </Card>
          ))
        }
      </div>
    </section>

    <section
      class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_18rem]"
    >
      <div aria-labelledby="recent-orders-title">
        <div
          class="mb-4 flex items-center justify-between gap-4"
        >
          <div>
            <h2
              id="recent-orders-title"
              class="text-lg font-black text-ink"
            >
              سفارش‌های اخیر
            </h2>

            <p class="mt-1 text-sm leading-6 text-muted">
              پنج سفارش ثبت‌شده اخیر فروشگاه.
            </p>
          </div>

          <Button
            href="/admin/orders"
            variant="ghost"
            size="sm"
          >
            همه سفارش‌ها
          </Button>
        </div>

        <Card
          as="div"
          padding="none"
          class="overflow-hidden shadow-none"
        >
          <div class="hidden border-b border-line bg-surface-soft px-5 py-3 md:block">
            <div
              class="grid grid-cols-[7rem_minmax(10rem,1fr)_9rem_8rem_7rem_5rem] gap-4 text-xs font-bold text-muted"
            >
              <span>شماره سفارش</span>
              <span>مشتری</span>
              <span>مبلغ</span>
              <span>وضعیت</span>
              <span>زمان</span>
              <span>عملیات</span>
            </div>
          </div>

          {
            hasDashboardError ? (
              <div
                class="p-5"
                role="alert"
              >
                <EmptyState
                  title="دریافت داشبورد انجام نشد"
                  description="ارتباط با سرور یا دریافت اطلاعات داشبورد با مشکل روبه‌رو شد. دوباره تلاش کنید."
                  compact
                />

                <div class="mt-4 flex justify-center">
                  <a
                    href={Astro.url.pathname}
                    class="inline-flex h-10 items-center justify-center rounded-xl border border-line px-4 text-sm font-bold text-ink transition hover:bg-surface"
                  >
                    تلاش مجدد
                  </a>
                </div>
              </div>
            ) : recentOrders.length === 0 ? (
              <div class="p-5">
                <EmptyState
                  title="سفارشی وجود ندارد"
                  description="در حال حاضر سفارشی برای نمایش وجود ندارد."
                  compact
                />
              </div>
            ) : (
              <div class="divide-y divide-line">
                {
                  recentOrders.map(
                    (
                      order:
                        AdminDashboardRecentOrder,
                    ) => (
                      <div
                        class="grid gap-3 px-5 py-4 md:grid-cols-[7rem_minmax(10rem,1fr)_9rem_8rem_7rem_5rem] md:items-center"
                      >
                        <span class="font-bold text-ink">
                          {order.orderNumber}
                        </span>

                        <span class="min-w-0 truncate text-sm text-ink">
                          {order.customerName}
                        </span>

                        <span class="text-sm font-bold text-ink">
                          {
                            order.totalRial !== null
                              ? formatRialAmount(
                                  order.totalRial,
                                )
                              : "—"
                          }
                        </span>

                        <Badge variant="neutral">
                          {
                            statusLabels[
                              order.status
                            ]
                          }
                        </Badge>

                        <span class="text-sm text-muted">
                          {
                            new Date(
                              order.createdAt,
                            ).toLocaleDateString(
                              "fa-IR",
                            )
                          }
                        </span>

                        <a
                          href={`/admin/orders/${order.id}`}
                          class="text-sm font-bold text-brand"
                        >
                          مشاهده
                        </a>
                      </div>
                    ),
                  )
                }
              </div>
            )
          }
        </Card>
      </div>

      <aside aria-labelledby="quick-actions-title">
        <div class="mb-4">
          <h2
            id="quick-actions-title"
            class="text-lg font-black text-ink"
          >
            عملیات سریع
          </h2>

          <p class="mt-1 text-sm leading-6 text-muted">
            مسیر کوتاه برای کارهای پرتکرار.
          </p>
        </div>

        <Card
          as="div"
          padding="md"
          class="shadow-none"
        >
          <div class="grid gap-3">
            <Button
              href="/admin/products/new"
              variant="primary"
            >
              افزودن محصول
            </Button>

            <Button
              href="/admin/orders"
              variant="secondary"
            >
              مشاهده سفارش‌ها
            </Button>

            <Button
              href="/admin/inventory"
              variant="secondary"
            >
              مدیریت موجودی
            </Button>
          </div>
        </Card>
      </aside>
    </section>
  </div>
</AdminLayout>
