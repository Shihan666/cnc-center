---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Badge from "../../../components/common/Badge.astro";
import Card from "../../../components/common/Card.astro";
import EmptyState from "../../../components/common/EmptyState.astro";

type OrderStatus =
  | "pending"
  | "awaiting_payment"
  | "paid"
  | "processing"
  | "ready_to_ship"
  | "shipped"
  | "completed"
  | "cancelled"
  | "expired";

type AdminOrder = {
  id: string | number;
  status: OrderStatus;
  createdAt: string;
  customerName?: string | null;
};

const response = await fetch(
  new URL("/api/admin/orders", Astro.request.url),
  {
    headers: {
      cookie: Astro.request.headers.get("cookie") ?? "",
    },
  },
);

const data: {
  ok: boolean;
  orders?: AdminOrder[];
  pagination?: {
    total: number;
    page: number;
    totalPages: number;
  };
} = await response.json();

const orders: AdminOrder[] = data.ok
  ? data.orders ?? []
  : [];

const pagination = data.ok
  ? data.pagination
  : null;

const statusLabels: Record<OrderStatus, string> = {
  pending: "در انتظار بررسی",
  awaiting_payment: "در انتظار پرداخت",
  paid: "پرداخت شده",
  processing: "در حال آماده‌سازی",
  ready_to_ship: "آماده ارسال",
  shipped: "ارسال شده",
  completed: "تکمیل شده",
  cancelled: "لغو شده",
  expired: "منقضی شده",
};
---

<AdminLayout title="سفارش‌ها">
  <div class="space-y-6">

    <section>
      <h2 class="text-lg font-black text-ink">
        مدیریت سفارش‌ها
      </h2>
      <p class="mt-1 text-sm text-muted">
        لیست سفارش‌های ثبت شده
      </p>
    </section>

    <section>
      <Card
        as="div"
        padding="none"
        class="overflow-hidden shadow-none"
      >
        {
          orders.length === 0 ? (
            <div class="p-5">
              <EmptyState
                title="سفارشی وجود ندارد"
                description="در حال حاضر سفارشی برای نمایش وجود ندارد."
                compact
              />
            </div>
          ) : (
            <div>
              <div class="divide-y divide-line">
                {
                  orders.map((order: AdminOrder) => (
                    <div class="grid gap-3 px-5 py-4 md:grid-cols-5 md:items-center">

                      <span class="font-bold text-ink">
                        {order.id}
                      </span>

                      <span class="text-sm text-muted">
                        {order.customerName ?? "-"}
                      </span>

                      <Badge variant="neutral">
                        {statusLabels[order.status]}
                      </Badge>

                      <span class="text-sm text-muted">
                        {new Date(order.createdAt).toLocaleDateString("fa-IR")}
                      </span>

                      <a
                        href={`/admin/orders/${order.id}`}
                        class="text-sm font-bold text-brand"
                      >
                        مشاهده
                      </a>

                    </div>
                  ))
                }
              </div>
            </div>
          )
        }
      </Card>
    </section>

    {
      pagination && (
        <section class="text-sm text-muted">
          صفحه {pagination.page} از {pagination.totalPages}
          — مجموع {pagination.total} سفارش
        </section>
      )
    }

  </div>
</AdminLayout>
