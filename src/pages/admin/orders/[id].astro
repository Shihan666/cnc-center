<script>
  const statusRoots =
    document.querySelectorAll(
      "[data-order-status-root]",
    );

  for (const root of statusRoots) {
    const button =
      root.querySelector(
        "[data-order-status-submit]",
      );

    const message =
      root.querySelector(
        "[data-order-status-message]",
      );

    if (
      !(root instanceof HTMLElement) ||
      !(button instanceof HTMLButtonElement) ||
      !(message instanceof HTMLElement)
    ) {
      continue;
    }

    const orderId =
      root.dataset.orderId ?? "";

    const nextStatus =
      root.dataset.nextStatus ?? "";

    button.addEventListener(
      "click",
      async () => {
        if (
          button.disabled ||
          !orderId ||
          !nextStatus
        ) {
          return;
        }

        const originalLabel =
          button.textContent ??
          "ØªØºÛŒÛŒØ± ÙˆØ¶Ø¹ÛŒØª";

        button.disabled = true;
        button.textContent =
          "Ø¯Ø± Ø­Ø§Ù„ Ø«Ø¨Øª...";

        message.textContent = "";
        message.classList.add("hidden");

        try {
          const response =
            await fetch(
              `/api/admin/orders/${encodeURIComponent(orderId)}/status`,
              {
                method: "POST",
                headers: {
                  "Content-Type":
                    "application/json",
                },
                credentials:
                  "same-origin",
                body:
                  JSON.stringify({
                    toStatus:
                      nextStatus,
                  }),
              },
            );

          let body:
            Record<string, unknown> | null =
              null;

          try {
            const value: unknown =
              await response.json();

            if (
              typeof value ===
                "object" &&
              value !== null &&
              !Array.isArray(value)
            ) {
              body =
                value as
                  Record<
                    string,
                    unknown
                  >;
            }
          } catch {
            body = null;
          }

          if (
            !response.ok ||
            body?.ok !== true
          ) {
            const reason =
              typeof body?.reason ===
                "string"
                ? body.reason
                : null;

            if (
              response.status === 401 ||
              reason ===
                "invalid_session"
            ) {
              window.location.replace(
                "/admin/auth/login",
              );

              return;
            }

            if (
              response.status === 409 ||
              reason ===
                "invalid_transition"
            ) {
              message.textContent =
                "ÙˆØ¶Ø¹ÛŒØª Ø³ÙØ§Ø±Ø´ ØªØºÛŒÛŒØ± Ú©Ø±Ø¯Ù‡ ÛŒØ§ Ø§ÛŒÙ† Ø§Ù†ØªÙ‚Ø§Ù„ Ø¯ÛŒÚ¯Ø± Ù…Ø¬Ø§Ø² Ù†ÛŒØ³Øª. ØµÙØ­Ù‡ Ø±Ø§ Ø¯ÙˆØ¨Ø§Ø±Ù‡ Ø¨Ø§Ø±Ú¯Ø°Ø§Ø±ÛŒ Ú©Ù†ÛŒØ¯.";
            } else {
              message.textContent =
                "ØªØºÛŒÛŒØ± ÙˆØ¶Ø¹ÛŒØª Ø³ÙØ§Ø±Ø´ Ø§Ù†Ø¬Ø§Ù… Ù†Ø´Ø¯. Ø¯ÙˆØ¨Ø§Ø±Ù‡ ØªÙ„Ø§Ø´ Ú©Ù†ÛŒØ¯.";
            }

            message.classList.remove(
              "hidden",
            );

            button.disabled = false;
            button.textContent =
              originalLabel;

            return;
          }

          window.location.reload();
        } catch {
          message.textContent =
            "Ø§Ø±ØªØ¨Ø§Ø· Ø¨Ø§ Ø³Ø±ÙˆØ± Ø¨Ø±Ù‚Ø±Ø§Ø± Ù†Ø´Ø¯. Ø¯ÙˆØ¨Ø§Ø±Ù‡ ØªÙ„Ø§Ø´ Ú©Ù†ÛŒØ¯.";

          message.classList.remove(
            "hidden",
          );

          button.disabled = false;
          button.textContent =
            originalLabel;
        }
      },
    );
  }

  const refundRoots =
    document.querySelectorAll(
      "[data-refund-actions-root]",
    );

  for (const root of refundRoots) {
    if (!(root instanceof HTMLElement)) {
      continue;
    }

    const refundIdRoot =
      root.querySelector(
        "[data-refund-id]",
      );

    if (!(refundIdRoot instanceof HTMLElement)) {
      continue;
    }

    const refundId =
      refundIdRoot.dataset.refundId ?? "";

    if (!refundId) {
      continue;
    }

    const actions =
      [
        {
          selector:
            "[data-refund-process]",
          endpoint:
            "process",
        },
        {
          selector:
            "[data-refund-complete]",
          endpoint:
            "complete",
        },
        {
          selector:
            "[data-refund-fail]",
          endpoint:
            "fail",
        },
      ];

    for (const action of actions) {
      const button =
        root.querySelector(
          action.selector,
        );

      if (!(button instanceof HTMLButtonElement)) {
        continue;
      }

      button.addEventListener(
        "click",
        async () => {
          if (button.disabled) {
            return;
          }

          button.disabled = true;

          try {
            const response =
              await fetch(
                `/api/admin/refunds/${encodeURIComponent(refundId)}/${action.endpoint}`,
                {
                  method:
                    "POST",

                  credentials:
                    "same-origin",
                },
              );

            let body:
              Record<string, unknown> | null =
              null;

            try {
              const value: unknown =
                await response.json();

              if (
                typeof value === "object" &&
                value !== null &&
                !Array.isArray(value)
              ) {
                body =
                  value as Record<string, unknown>;
              }
            } catch {
              body = null;
            }

            if (
              !response.ok ||
              body?.ok !== true
            ) {
              if (
                response.status === 401 ||
                body?.reason === "invalid_session"
              ) {
                window.location.replace(
                  "/admin/auth/login",
                );

                return;
              }

              button.disabled = false;

              return;
            }

            window.location.reload();

          } catch {
            button.disabled = false;
          }
        },
      );
    }
  }
</script>







