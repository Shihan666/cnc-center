import AdminLayout from "../../../layouts/AdminLayout.astro";
import Badge from "../../../components/common/Badge.astro";
import Button from "../../../components/common/Button.astro";
import Card from "../../../components/common/Card.astro";
import EmptyState from "../../../components/common/EmptyState.astro";
import { formatRialAmount } from "../../../lib/cart";

type OrderStatus =
  | "pending"
  | "paid"
  | "processing"
  | "ready_to_ship"
  | "shipped"
  | "completed"
  | "cancelled"
  | "awaiting_payment"
  | "expired";

type AdminOrderDetailItem = {
  id: string;
  productId: string;
  productName: string;
  brand: string;
  partNumber: string;
  quantity: number;
  unitPriceRial: number;
  lineTotalRial: number;
  shippingClass: string;
  createdAt: string;
};

type AdminOrderRefund = {
  id: string;
  paymentId: string;
  amountRial: number;
  status: string;
  reason: string | null;
  createdAt: string;
  completedAt: string | null;
};


type AdminOrderPayment = {
  id: string;
  provider: string;
  environment: string;
  status: string;
  amountRial: number;
  currency: string;
  refId: string | null;
  createdAt: string;
  requestedAt: string | null;
  verifiedAt: string | null;
  failedAt: string | null;
};

type AdminOrderStatusHistoryItem = {
  id: string;
  fromStatus: OrderStatus | null;
  toStatus: OrderStatus;
  reason: string | null;
  createdAt: string;
};

type AdminOrderDetail = {
  id: string;
  orderNumber: string;
  status: OrderStatus;
  customerName: string;
  customerPhone: string;
  customerCity: string;
  customerAddress: string;
  customerNotes: string;
  shippingMethodId: string;
  shippingMethodLabel: string;
  subtotalRial: number;
  shippingFeeRial: number | null;
  totalRial: number | null;
  currency: string;
  paymentReady: boolean;
  createdAt: string;
  updatedAt: string;
  paidAt: string | null;
  items: AdminOrderDetailItem[];
  payments: AdminOrderPayment[];
  refunds: AdminOrderRefund[];
  statusHistory: AdminOrderStatusHistoryItem[];
};

type AdminOrderDetailResponse = {
  ok: boolean;
  order?: AdminOrderDetail;
};

const orderId =
  Astro.params.id ?? "";

const apiUrl =
  new URL(
    `/api/admin/orders/${encodeURIComponent(orderId)}`,
    Astro.request.url,
  );

const response =
  await fetch(
    apiUrl,
    {
      headers: {
        cookie:
          Astro.request.headers.get(
            "cookie",
          ) ?? "",
      },
    },
  );

let data: AdminOrderDetailResponse | null =
  null;

try {
  data =
    await response.json();
} catch {
  data = null;
}

const order =
  response.ok &&
  data?.ok === true
    ? data.order ?? null
    : null;

const isNotFound =
  response.status === 404;

const hasOrderError =
  !isNotFound &&
  (
    !response.ok ||
    data?.ok !== true ||
    !order
  );


const statusLabels: Record<OrderStatus, string> = {
  pending: "در ا� تظار بررس�R",
  paid: "پرداخت شد�!",
  processing: "در حا� پردازش",
  ready_to_ship: "آ�&اد�! ارسا�",
  shipped: "ارسا� شد�!",
  completed: "تک�&�R� شد�!",
  cancelled: "�غ�� شد�!",
  awaiting_payment: "در ا� تظار پرداخت",
  expired: "�&� �ض�R شد�!",
};

const nextAdminStatus: Partial<
  Record<OrderStatus, OrderStatus>
> = {
  paid: "processing",
  processing: "ready_to_ship",
  ready_to_ship: "shipped",
  shipped: "completed",
};

const nextStatus =
  order
    ? nextAdminStatus[order.status] ?? null
    : null;


