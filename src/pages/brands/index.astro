---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Badge from "../../components/common/Badge.astro";
import Button from "../../components/common/Button.astro";
import Card from "../../components/common/Card.astro";

import { siteConfig } from "../../config/site";

import {
  getActiveBrands,
  getBrandHref,
} from "../../lib/brands";

const allBrands = await getCollection("brands");
const brands = getActiveBrands(allBrands);

const siteUrl = siteConfig.seo.siteUrl.replace(/\/$/, "");
const canonical = `${siteUrl}/brands/`;

const pageTitle = "برندهای CNC و اتوماسیون صنعتی";

const pageDescription =
  "فهرست برندهای فعال در حوزه تعمیر، بررسی و تأمین قطعات CNC شامل کنترلر، سروو، درایو، اسپیندل، PLC، HMI، انکودر و تجهیزات صنعتی.";

const structuredData =
  brands.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "برندهای CNC Center",
        itemListElement: brands.map((brand, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: brand.data.name,
          url: `${siteUrl}${getBrandHref(brand)}`,
        })),
      }
    : null;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
>
  {
    structuredData && (
      <script
        slot="head"
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      ></script>
    )
  }

  <main>
    <section class="border-b border-line bg-surface-raised py-12 md:py-18">
      <div class="site-container">
        <div class="max-w-4xl">
          <Badge variant="brand">
            برندهای صنعتی
          </Badge>

          <h1 class="mt-5 text-3xl font-black leading-[1.45] tracking-tight text-ink md:text-5xl">
            برندهای CNC و اتوماسیون صنعتی
          </h1>

          <p class="mt-5 max-w-3xl text-base leading-8 text-muted md:text-lg">
            فهرست برندهایی که در حوزه بررسی فنی، تعمیر تجهیزات
            و تأمین قطعات CNC در CNC Center پوشش داده می‌شوند.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <Button
              href="/shop/"
              size="lg"
            >
              مشاهده فروشگاه قطعات
            </Button>

            <Button
              href="/request/part/"
              variant="secondary"
              size="lg"
            >
              درخواست قطعه بر اساس برند
            </Button>
          </div>
        </div>
      </div>
    </section>

    <section class="section-space bg-surface">
      <div class="site-container">
        {
          brands.length > 0 ? (
            <>
              <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
                <div>
                  <p class="text-sm font-bold text-brand-700">
                    فهرست فعال
                  </p>

                  <h2 class="mt-2 text-2xl font-black text-ink md:text-3xl">
                    برندهای تحت پوشش
                  </h2>

                  <p class="mt-3 max-w-2xl text-sm leading-7 text-muted">
                    برای مشاهده حوزه کاری هر برند و در ادامه محصولات
                    و خدمات مرتبط، وارد صفحه اختصاصی آن برند شوید.
                  </p>
                </div>

                <p class="text-sm font-bold text-muted">
                  {new Intl.NumberFormat("fa-IR").format(brands.length)}
                  {" "}
                  برند
                </p>
              </div>

              <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                {
                  brands.map((brand) => (
                    <Card
                      interactive={true}
                      class="group flex h-full flex-col"
                    >
                      <div class="flex items-start justify-between gap-4">
                        <Badge
                          variant="brand"
                          size="sm"
                        >
                          برند
                        </Badge>

                        <span
                          aria-hidden="true"
                          class="text-line-strong transition group-hover:text-brand-600"
                        >
                          ←
                        </span>
                      </div>

                      <p
                        dir="ltr"
                        class="mt-6 text-2xl font-black tracking-tight text-ink"
                      >
                        {brand.data.name}
                      </p>

                      <p class="mt-3 flex-1 text-sm leading-7 text-muted">
                        {brand.data.focus}
                      </p>

                      <a
                        href={getBrandHref(brand)}
                        class="mt-6 inline-flex min-h-10 items-center text-sm font-bold text-brand-700 transition hover:text-brand-900"
                        aria-label={`مشاهده صفحه برند ${brand.data.name}`}
                      >
                        مشاهده برند
                      </a>
                    </Card>
                  ))
                }
              </div>
            </>
          ) : (
            <div class="mx-auto max-w-3xl rounded-panel border border-line bg-surface-raised p-8 text-center shadow-card md:p-12">
              <h2 class="text-2xl font-black text-ink">
                فهرست برندها در حال آماده‌سازی است
              </h2>

              <p class="mx-auto mt-3 max-w-xl text-sm leading-8 text-muted">
                برای بررسی یک برند یا Part Number خاص می‌توانید درخواست قطعه ثبت کنید.
              </p>

              <div class="mt-6">
                <Button href="/request/part/">
                  ثبت درخواست قطعه
                </Button>
              </div>
            </div>
          )
        }
      </div>
    </section>

    <section class="border-t border-line bg-surface-raised py-10 md:py-12">
      <div class="site-container">
        <div class="grid gap-4 md:grid-cols-3">
          <div class="rounded-card border border-line bg-surface p-5">
            <p class="text-sm font-bold text-brand-700">
              تطبیق فنی
            </p>

            <p class="mt-2 font-black text-ink">
              بررسی برند و Part Number
            </p>

            <p class="mt-2 text-sm leading-7 text-muted">
              شماره فنی، مدل و سازگاری قطعه پیش از سفارش بررسی می‌شود.
            </p>
          </div>

          <div class="rounded-card border border-line bg-surface p-5">
            <p class="text-sm font-bold text-brand-700">
              تعمیر تجهیزات
            </p>

            <p class="mt-2 font-black text-ink">
              بررسی تجهیزات CNC
            </p>

            <p class="mt-2 text-sm leading-7 text-muted">
              تجهیزات قابل تعمیر بر اساس نوع خرابی و شرایط فنی ارزیابی می‌شوند.
            </p>
          </div>

          <div class="rounded-card border border-line bg-surface p-5">
            <p class="text-sm font-bold text-brand-700">
              تأمین قطعات
            </p>

            <p class="mt-2 font-black text-ink">
              مسیر خرید، استعلام یا تأمین
            </p>

            <p class="mt-2 text-sm leading-7 text-muted">
              بسته به موجودی و نوع قطعه، مسیر مناسب سفارش مشخص می‌شود.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>